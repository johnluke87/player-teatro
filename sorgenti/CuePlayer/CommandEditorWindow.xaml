<ui:FluentWindow x:Class="CuePlayer.CommandEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:CuePlayer.ViewModels"
        xmlns:local="clr-namespace:CuePlayer"
        Title="{Binding WindowTitle}" Width="1140" Height="780" MinWidth="980" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">

    <Window.Resources>
        <local:SecondsLabelConverter x:Key="Secs"/>
        <local:EqualsConverter x:Key="Eq"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- one track row -->
        <DataTemplate DataType="{x:Type vm:ActionRowViewModel}">
            <Border x:Name="Row" Background="{StaticResource RowBrush}" CornerRadius="9" Padding="14,10" Margin="0,0,0,6"
                    BorderThickness="2" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding File}" Margin="0,0,12,6"/>

                    <ItemsControl Grid.Column="1" VerticalAlignment="Center" ItemsSource="{x:Static vm:CommandEditorViewModel.Kinds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipBtn}" Content="{Binding Label}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.SetKindCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource Eq}">
                                            <Binding Path="Kind"/>
                                            <Binding Path="DataContext.Kind" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </Button.Tag>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Grid.Column="1" Content="riparti da capo" IsChecked="{Binding FromStart}" Foreground="{StaticResource TextBrush}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,6"
                              Visibility="{Binding IsPlay, Converter={StaticResource BoolVis}}"
                              ToolTip="Riparte dall'inizio anche se stava già suonando"/>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsTimed, Converter={StaticResource BoolVis}}">
                        <!-- level -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsLevel, Converter={StaticResource BoolVis}}"
                                    Margin="0,0,22,0" ToolTip="A che volume deve arrivare (100% = volume pieno della traccia)">
                            <TextBlock Text="volume" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ItemsControl ItemsSource="{x:Static vm:CommandEditorViewModel.LevelChoices}" VerticalAlignment="Center"
                                          Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChipBtn}" Content="{Binding}" ContentStringFormat="{}{0}%"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding StringFormat={}{0}%}"
                                                Command="{Binding DataContext.SetLevelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <Button.Tag>
                                                <MultiBinding Converter="{StaticResource Eq}">
                                                    <Binding/>
                                                    <Binding Path="DataContext.Level" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                </MultiBinding>
                                            </Button.Tag>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- time -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsTimed, Converter={StaticResource BoolVis}}"
                                    ToolTip="Quanto dura il passaggio">
                            <TextBlock Text="tempo" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ItemsControl ItemsSource="{x:Static vm:CommandEditorViewModel.SecondsChoices}" VerticalAlignment="Center"
                                          Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChipBtn}" Content="{Binding Converter={StaticResource Secs}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Converter={StaticResource Secs}}"
                                                Command="{Binding DataContext.SetSecondsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <Button.Tag>
                                                <MultiBinding Converter="{StaticResource Eq}">
                                                    <Binding/>
                                                    <Binding Path="DataContext.Seconds" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                </MultiBinding>
                                            </Button.Tag>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource SubBrush}"
                               Margin="2,2,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Play">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="#1C2E25"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Volume">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="#17302E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Stop">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="#2E1E20"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Pause">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="#2E291C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="None">
                    <Setter TargetName="Row" Property="Opacity" Value="0.75"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{Binding WindowTitle}" ShowMinimize="False" Background="{StaticResource PanelBrush}">
            <ui:TitleBar.Icon><ui:ImageIcon Source="{StaticResource LogoImage}"/></ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- name + colour -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="22,8,22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NOME DEL PULSANTE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                    <ui:TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="19" FontWeight="SemiBold"
                                MaxWidth="560" HorizontalAlignment="Left" MinWidth="440" PlaceholderText="es. Entra MusicaB"/>
                    <StackPanel Visibility="{Binding NotesEnabled, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="NOTA DI REGIA  ·  quando va dato" Style="{StaticResource SectionLabel}" Margin="0,12,0,6"/>
                        <ui:TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxWidth="560" HorizontalAlignment="Left" MinWidth="440"
                                    PlaceholderText="es. quando il servo apre la porta · battuta «E ora, signori…»"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ActsEnabled, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="ATTO / SCENA  ·  per raggrupparli" Style="{StaticResource SectionLabel}" Margin="0,12,0,6"/>
                        <ComboBox IsEditable="True" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding KnownGroups}"
                                  MaxWidth="560" MinWidth="440" HorizontalAlignment="Left" ToolTip="Scrivi un nome nuovo (es. Atto I) o scegline uno già usato"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="COLORE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{x:Static vm:CommandEditorViewModel.Colors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipBtn}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding}"
                                        Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource Eq}">
                                            <Binding/>
                                            <Binding Path="DataContext.Color" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Button.Tag>
                                    <Ellipse Width="20" Height="20" Fill="{Binding}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,14,0,0" MaxWidth="470" HorizontalAlignment="Left"
                            Visibility="{Binding ChainEnabled, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding AutoNext}" Content="Dopo questo comando, esegui da solo il prossimo"
                                      ToolTip="Comandi in catena: il comando successivo parte da solo dopo il tempo scelto"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding AutoNext, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="dopo" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <ItemsControl ItemsSource="{x:Static vm:CommandEditorViewModel.AutoChoices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel MaxWidth="400"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ChipBtn}" Content="{Binding Converter={StaticResource Secs}}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.SetAutoSecondsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Button.Tag>
                                                    <MultiBinding Converter="{StaticResource Eq}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.AutoNextSeconds" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Button.Tag>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- helper bar -->
        <Border Grid.Row="2" Padding="22,12,22,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Command="{Binding SnapshotCommand}" Padding="14,8"
                        ToolTip="Mette in questo comando le tracce che stanno suonando adesso, al loro volume attuale">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Prendi la situazione attuale"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Stesso tempo per tutte:" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ItemsControl ItemsSource="{x:Static vm:CommandEditorViewModel.SecondsChoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn}" Height="30" Padding="10,0" Margin="0,0,4,0" FontSize="12" FontWeight="Normal"
                                        Content="{Binding Converter={StaticResource Secs}}" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.AllSecondsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap">
                    Quando premi questo pulsante, <Run Foreground="{StaticResource TextBrush}" FontWeight="SemiBold">ogni traccia fa quello che scegli qui</Run>, tutte insieme.
                    <LineBreak/><Run Text="Es.: MusicaB ▶ Parte  +  MusicaA 🔉 Volume 20%  → parte MusicaB e MusicaA si abbassa."/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- tracks -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="22,6,22,6">
            <ItemsControl ItemsSource="{Binding Rows}"/>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" Padding="22,14" BorderBrush="#10FFFFFF" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="#1A2840" CornerRadius="8" Padding="12,8" BorderBrush="{StaticResource BlueBrush}"
                        BorderThickness="3,0,0,0" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="COSA FARÀ" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="DeleteBtn" Style="{StaticResource Btn}" Content="Elimina" Click="Delete_Click" Margin="0,0,24,0"
                            Background="#3A2226" Foreground="#FF8A8F"/>
                    <Button Style="{StaticResource Btn}" Command="{Binding TryCommand}" Margin="0,0,8,0"
                            ToolTip="Esegue subito il comando così com'è, per sentire come viene">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Prova"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Content="Annulla" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Btn}" Content="Salva" Click="Save_Click" Background="{StaticResource GreenBrush}" Foreground="White"
                            IsEnabled="{Binding CanSave}" MinWidth="110"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
