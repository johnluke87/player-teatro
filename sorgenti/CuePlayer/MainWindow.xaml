<ui:FluentWindow x:Class="CuePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:CuePlayer.ViewModels"
        xmlns:local="clr-namespace:CuePlayer"
        Title="RTC Stage" Width="1600" Height="900" MinWidth="1340" MinHeight="640" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <local:InverseBoolConverter x:Key="Not"/>
        <local:EqualsConverter x:Key="Eq"/>
        <local:SecondsLabelConverter x:Key="Secs"/>
        <local:AllTrueVisibilityConverter x:Key="AllTrueVis"/>

        <!-- one EQ band: vertical fader, double-click = 0 dB -->
        <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
            <StackPanel Margin="8,0" Width="60">
                <TextBlock Text="{Binding GainText}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                <Slider Orientation="Vertical" Height="150" Margin="0,8" HorizontalAlignment="Center"
                        Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Gain}"
                        SmallChange="0.5" LargeChange="2" TickFrequency="6" TickPlacement="BottomRight"
                        PreviewMouseWheel="Slider_PreviewMouseWheel" MouseDoubleClick="EqSlider_DoubleClick"
                        ToolTip="Doppio clic = 0 dB · rotella = mezzo dB"/>
                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource SubBrush}"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="PlayPauseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Content" Value="&#xE768;"/>
            <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ToolTip" Value="Play / riprendi"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;"/>
                    <Setter Property="Background" Value="{StaticResource AmberBrush}"/>
                    <Setter Property="ToolTip" Value="Pausa"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopupCard" TargetType="Border">
            <Setter Property="Background" Value="#262A31"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45"/></Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="12"/>
        </Style>

        <!-- ================= one track ================= -->
        <DataTemplate DataType="{x:Type vm:CueViewModel}">
            <Grid Margin="0,0,0,8">
                <Border x:Name="Row" Style="{StaticResource Card}" Cursor="Hand" MouseLeftButtonDown="Row_MouseLeftButtonDown"
                        ToolTip="Clic sulla riga: diventa la prossima traccia del GO (se non usi i comandi)">
                    <Grid Margin="0,10,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*" MinWidth="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Accent" CornerRadius="3" Margin="0,-4,0,-4" Background="Transparent"/>

                        <TextBlock Grid.Column="1" Text="{Binding Number}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- title + progress -->
                        <Grid Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Background="{StaticResource BlueBrush}" CornerRadius="5"
                                        Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsNext, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="PROSSIMA" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock x:Name="StateLabel" DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="11.5"
                                           FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource SubBrush}"/>
                                <Border x:Name="TrimChip" DockPanel.Dock="Right" Background="#2B3138" CornerRadius="9" Padding="7,1"
                                        Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                        ToolTip="Questa traccia suona solo da… a… (pulsante forbici)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C6;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,5,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource AmberBrush}"/>
                                        <TextBlock Text="{Binding TrimSummary}" FontSize="11" Foreground="{StaticResource SubBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                             Background="#353B44" BorderThickness="0" Foreground="{StaticResource GreenBrush}"
                                             MouseLeftButtonDown="Progress_MouseLeftButtonDown" Cursor="Hand"
                                             ToolTip="Clic per saltare a quel punto">
                                    <ProgressBar.Visibility>
                                        <MultiBinding Converter="{StaticResource AllTrueVis}" ConverterParameter="invert">
                                            <Binding Path="HasPeaks"/>
                                            <Binding Path="DataContext.Features.Waveform" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </ProgressBar.Visibility>
                                </ProgressBar>
                                <local:WaveformView Height="30" Peaks="{Binding Peaks}" Progress="{Binding Progress}"
                                                    PlayedBrush="{Binding Foreground, ElementName=Bar}"
                                                    StartFraction="{Binding TrimStartFraction}" EndFraction="{Binding TrimEndFraction}"
                                                    MouseLeftButtonDown="Progress_MouseLeftButtonDown" Cursor="Hand"
                                                    ToolTip="Forma d'onda · clic per saltare a quel punto">
                                    <local:WaveformView.Visibility>
                                        <MultiBinding Converter="{StaticResource AllTrueVis}">
                                            <Binding Path="HasPeaks"/>
                                            <Binding Path="DataContext.Features.Waveform" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </local:WaveformView.Visibility>
                                </local:WaveformView>
                                <TextBlock x:Name="Time" Grid.Column="1" Text="{Binding TimeText}" FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                           Margin="14,0,0,0" MinWidth="130" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- transport -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsReady}">
                            <Button Style="{StaticResource PlayPauseBtn}" Command="{Binding PlayPauseCommand}" Width="52"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE71A;" Command="{Binding StopCommand}" ToolTip="Stop (torna all'inizio)"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Command="{Binding RestartCommand}" ToolTip="Riparti da capo"/>
                        </StackPanel>

                        <!-- fade: split button (action + duration menu) -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding IsReady}">
                            <Button Style="{StaticResource SplitLeft}" Background="{StaticResource OrangeBrush}" Foreground="White"
                                    Command="{Binding FadeCommand}" MinWidth="104" ToolTip="Sfuma fino al silenzio e ferma">
                                <TextBlock Text="{Binding FadeLabel}"/>
                            </Button>
                            <Button Style="{StaticResource SplitRight}" Background="{StaticResource OrangeBrush}" Foreground="White"
                                    Click="FadeMenu_Click" Tag="cue" ToolTip="Durata della sfumata">
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <!-- volume -->
                        <DockPanel Grid.Column="5" Margin="18,0,8,0" VerticalAlignment="Center"
                                   ToolTip="Volume traccia (anche con la rotella del mouse)">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Width="46">
                                <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" TextAlignment="Right" FontSize="13"/>
                                <TextBlock Text="{Binding NormalizationText}" TextAlignment="Right" FontSize="10" Foreground="{StaticResource TealBrush}"
                                           ToolTip="Volumi uniformati: correzione automatica di questa traccia"/>
                            </StackPanel>
                            <Slider Value="{Binding Volume}" PreviewMouseWheel="Slider_PreviewMouseWheel"/>
                        </DockPanel>

                        <!-- loop · trim · EQ -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#xE7F6;" Command="{Binding PreviewCommand}" IsEnabled="{Binding IsReady}"
                                    Visibility="{Binding DataContext.Features.Preview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"
                                    ToolTip="Pre-ascolto in cuffia: la senti solo tu, non in sala">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                        <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ToggleButton Style="{StaticResource LoopToggle}" Content="&#xE8EE;" Margin="2,0"
                                          IsChecked="{Binding Loop}" IsEnabled="{Binding IsReady}" ToolTip="Ripeti in loop"/>

                            <Grid Margin="2,0" Visibility="{Binding DataContext.Features.Trim, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                                <ToggleButton x:Name="TrimBtn" Content="&#xE8C6;" IsEnabled="{Binding IsReady}"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=TrimPop, Converter={StaticResource Not}}"
                                              ToolTip="Inizio e fine: fai suonare solo un pezzo della traccia">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource LoopToggle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrimActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Popup x:Name="TrimPop" IsOpen="{Binding IsChecked, ElementName=TrimBtn}" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=TrimBtn}" Placement="Left" AllowsTransparency="True">
                                    <Border Style="{StaticResource PopupCard}" Width="430">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Azzera" Height="30" Padding="10,0"
                                                        FontSize="12" Command="{Binding ClearTrimCommand}"/>
                                                <TextBlock FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="&#xE8C6;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AmberBrush}"/>
                                                    <Run Text=" Inizio e fine"/>
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource SubBrush}" FontSize="12" Margin="0,2,0,10"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Inizio" VerticalAlignment="Center"/>
                                                <ui:TextBox Grid.Column="1" Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" PlaceholderText="dall'inizio"
                                                            KeyDown="TimeBox_KeyDown" Margin="0,0,8,6"/>
                                                <Button Grid.Column="2" Style="{StaticResource Btn}" Height="34" Padding="10,0" FontSize="12" Margin="0,0,0,6"
                                                        Command="{Binding SetStartHereCommand}" ToolTip="Usa il punto in cui si trova adesso la traccia">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE7B7;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="da qui"/>
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Grid.Row="1" Text="Fine" VerticalAlignment="Center"/>
                                                <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EndText, UpdateSourceTrigger=LostFocus}" PlaceholderText="fino alla fine"
                                                            KeyDown="TimeBox_KeyDown" Margin="0,0,8,0"/>
                                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Btn}" Height="34" Padding="10,0" FontSize="12"
                                                        Command="{Binding SetEndHereCommand}" ToolTip="Usa il punto in cui si trova adesso la traccia">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE7B7;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="fin qui"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="SFUMA PRIMA DELLA FINE"/>
                                            <ItemsControl ItemsSource="{x:Static vm:CueViewModel.EndFadeChoices}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource ChipBtn}" Content="{Binding Converter={StaticResource Secs}}" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.SetEndFadeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                            <Button.Tag>
                                                                <MultiBinding Converter="{StaticResource Eq}">
                                                                    <Binding/>
                                                                    <Binding Path="DataContext.EndFade" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                </MultiBinding>
                                                            </Button.Tag>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubBrush}" Margin="0,6,0,0" LineHeight="18">
                                                Scrivi i tempi come <Run Foreground="{StaticResource TextBrush}">1:15</Run> o <Run Foreground="{StaticResource TextBrush}">75</Run> (secondi), poi Invio.
                                                Oppure fai suonare la traccia e premi «da qui» / «fin qui» nel momento giusto.
                                                «subito» alla voce sfuma = si ferma netta.
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Grid Margin="2,0" Visibility="{Binding DataContext.Features.TrackEq, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                                <ToggleButton x:Name="EqBtn" Content="EQ"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=EqPop, Converter={StaticResource Not}}"
                                              ToolTip="Equalizzatore di questa traccia (bassi, medi, alti)">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource TextToggle}">
                                            <Setter Property="Width" Value="44"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EqActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Popup x:Name="EqPop" IsOpen="{Binding IsChecked, ElementName=EqBtn}" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=EqBtn}" Placement="Left" AllowsTransparency="True">
                                    <Border Style="{StaticResource PopupCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Azzera" Height="30" Padding="10,0"
                                                        FontSize="12" Command="{Binding ResetEqCommand}"/>
                                                <TextBlock Text="{Binding Title, StringFormat=EQ · {0}}" FontWeight="Bold" VerticalAlignment="Center"
                                                           MaxWidth="200" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding EqBands}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- end warning glow -->
                <Border x:Name="EndGlow" CornerRadius="10" BorderBrush="{StaticResource RedBrush}" BorderThickness="2"
                        Background="#30D63B43" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNext}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                    <Setter TargetName="Row" Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TrimActive}" Value="True">
                    <Setter TargetName="TrimChip" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="playing">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource GreenBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="#1B3127"/>
                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource GreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="paused">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource AmberBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="#31291B"/>
                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="fading">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource OrangeBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="#33241B"/>
                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="fadingin">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource BlueBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="#1B273B"/>
                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource BlueBrush}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource BlueBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="ducking">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource AmberBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="#2D2A1D"/>
                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="ducked">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource TealBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="#172F2D"/>
                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource TealBrush}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource TealBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="error">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource RedBrush}"/>
                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource RedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="loading">
                    <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnding}" Value="True">
                    <Setter TargetName="Time" Property="Foreground" Value="#FF8A8F"/>
                    <Setter TargetName="Time" Property="FontWeight" Value="Bold"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Blink">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="EndGlow" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Blink"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <ui:TitleBar Title="RTC Stage · RamonTeaConta" Background="{StaticResource PanelBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{StaticResource LogoImage}"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- toolbar -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="16,4,16,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Click="OpenFolder_Click"
                        ToolTip="Scegli la cartella con le musiche dello spettacolo">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Apri cartella"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Command="{Binding RescanCommand}" Margin="8,0,0,0"
                        IsEnabled="{Binding HasFolder}" ToolTip="Rilegge la cartella (lo fa anche da solo quando aggiungi file)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Aggiorna"/>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn}" Background="{StaticResource BrandBrush}" Foreground="White" Click="ShowMode_Click"
                            Visibility="{Binding Features.ShowMode, Converter={StaticResource BoolVis}}" Margin="0,0,8,0"
                            ToolTip="Vista a schermo intero per lo spettacolo: GO enorme, comando in corso e prossimo, note, tempi (F11)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE740;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Modalità spettacolo"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Click="ShowMenu_Click" Margin="0,0,8,0"
                            Visibility="{Binding Features.AnyShowTools, Converter={StaticResource BoolVis}}"
                            ToolTip="Stampa la scaletta, fai o ripristina un backup dello spettacolo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Spettacolo"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Click="Features_Click" Margin="0,0,16,0"
                            ToolTip="Funzioni: scegli quali strumenti mostrare">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Funzioni"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SubBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Uscita audio (sala)"/>
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="240"
                              VerticalContentAlignment="Center" ToolTip="Uscita audio (sala)"/>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                Visibility="{Binding Features.Preview, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource BlueBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Cuffia per il pre-ascolto"/>
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding PreviewDevice}" Width="200"
                                  VerticalContentAlignment="Center" ToolTip="Cuffia per il pre-ascolto (deve essere diversa dall'uscita in sala)"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding Folder}" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"
                           Margin="16,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}"/>
            </DockPanel>
        </Border>

        <!-- commands panel (right) -->
        <Border Grid.Row="2" HorizontalAlignment="Right" Width="360" Background="{StaticResource PanelBrush}"
                BorderBrush="#10FFFFFF" BorderThickness="1,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,16,16,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Command="{Binding NewCommandCommand}"
                            Background="{StaticResource BlueBrush}" Foreground="White" Height="36" Padding="12,0" IsEnabled="{Binding HasCues}"
                            ToolTip="Crea un pulsante che fa fare alle tracce quello che vuoi">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Nuovo"/>
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Comandi" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="clic o tasto 1-9 · GO li esegue in ordine" FontSize="11.5" Foreground="{StaticResource SubBrush}"/>
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="12,0,12,12">
                        <ItemsControl ItemsSource="{Binding CommandsView}" Focusable="False">
                            <!-- acts / scenes: a collapsible header per group -->
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <Expander IsExpanded="True" Margin="0,0,0,6" Foreground="{StaticResource TextBrush}">
                                                            <Expander.Header>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"/>
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat='  ·  {0}'}" FontSize="12" Foreground="{StaticResource SubBrush}"/>
                                                                </StackPanel>
                                                            </Expander.Header>
                                                            <ItemsPresenter Margin="0,6,0,0"/>
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CommandViewModel}">
                                    <Grid Margin="0,0,0,8">
                                        <Button x:Name="Pad" Command="{Binding RunCommand}" Focusable="False" Cursor="Hand"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}" ToolTip="Clic per eseguire">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Border x:Name="b" Background="{StaticResource RowBrush}" CornerRadius="10"
                                                                BorderThickness="1" BorderBrush="#12FFFFFF">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="6"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Background="{Binding ColorBrush}" CornerRadius="9,0,0,9"/>
                                                                <ContentPresenter Grid.Column="1"/>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="hover" CornerRadius="10" Background="White" Opacity="0" IsHitTestVisible="False"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="hover" Property="Opacity" Value="0.05"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="hover" Property="Opacity" Value="0.12"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                                                            <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid Margin="12,11,44,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding ColorBrush}"
                                                        VerticalAlignment="Top" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Number}" FontSize="15" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{StaticResource BlueBrush}" CornerRadius="4" Padding="5,0" Margin="0,0,6,2"
                                                                VerticalAlignment="Center" Visibility="{Binding IsNext, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="PROSSIMO" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <Border Background="#24402F" CornerRadius="4" Padding="5,0" Margin="0,0,6,2"
                                                                VerticalAlignment="Center" Visibility="{Binding IsLast, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="✓ ESEGUITO" FontSize="10" FontWeight="Bold" Foreground="#7FD6A4"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock FontSize="12" Foreground="#E9C77A" TextWrapping="Wrap" Margin="0,3,0,0" FontStyle="Italic">
                                                        <TextBlock.Visibility>
                                                            <MultiBinding Converter="{StaticResource AllTrueVis}">
                                                                <Binding Path="HasNote"/>
                                                                <Binding Path="DataContext.Features.Notes" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Visibility>
                                                        <Run Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontStyle="Normal"/> <Run Text="{Binding Note, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource SubBrush}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>
                                                    <TextBlock FontSize="11.5" Foreground="#8DB8FF" Margin="0,3,0,0" TextWrapping="Wrap">
                                                        <TextBlock.Visibility>
                                                            <MultiBinding Converter="{StaticResource AllTrueVis}">
                                                                <Binding Path="AutoNext"/>
                                                                <Binding Path="DataContext.Features.Chain" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Visibility>
                                                        <Run Text="&#xE916;" FontFamily="{StaticResource IconFont}"/> <Run Text="{Binding AutoNextText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <!-- edit / reorder, outside the pad so they don't run it -->
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE70F;" Command="{Binding EditCommand}"
                                                    Width="30" Height="30" FontSize="12" Margin="0" ToolTip="Modifica"
                                                    AutomationProperties.Name="Modifica"/>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE70E;" Click="CommandUp_Click"
                                                    Width="30" Height="22" FontSize="10" Margin="0,4,0,0" Background="Transparent" BorderBrush="Transparent" ToolTip="Sposta su"/>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE70D;" Click="CommandDown_Click"
                                                    Width="30" Height="22" FontSize="10" Margin="0" Background="Transparent" BorderBrush="Transparent" ToolTip="Sposta giù"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- empty state -->
                    <StackPanel VerticalAlignment="Top" Margin="22,30,22,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCommands}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="{StaticResource BlueBrush}"/>
                        <TextBlock Text="Nessun comando" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubBrush}" LineHeight="20">
                            Un comando è un pulsante che fa fare più cose insieme alle tracce. Ad esempio:
                            <LineBreak/><Run Foreground="{StaticResource TextBrush}">«Entra MusicaB»</Run> → MusicaB ▶ parte, MusicaA 🔉 volume 20%
                            <LineBreak/><Run Foreground="{StaticResource TextBrush}">«Torna MusicaA»</Run> → MusicaB ⏹ stop, MusicaA 🔉 volume 100%
                            <LineBreak/><LineBreak/>Premi <Run FontWeight="Bold" Foreground="{StaticResource TextBrush}">+ Nuovo</Run> per crearne uno.
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- track list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="16,14,16,6" Margin="0,0,360,0">
            <ItemsControl ItemsSource="{Binding Cues}" Focusable="False"/>
        </ScrollViewer>
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,360,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasCues}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Image Source="{StaticResource LogoImage}" Width="96" Height="96" Opacity="0.9"/>
            <TextBlock Text="Nessuna musica" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
            <TextBlock Text="Premi «Apri cartella» e scegli la cartella con i file MP3, WAV, M4A, FLAC…" Foreground="{StaticResource SubBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Ordine = nome del file: rinominali 01_…, 02_…, 03_… per fare la scaletta." Foreground="{StaticResource SubBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- master bar -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="16,14" BorderBrush="#10FFFFFF" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource BigBtn}" Command="{Binding GoCommand}" Background="{StaticResource GreenBrush}" Foreground="White"
                        MinWidth="170" ToolTip="Esegue il PROSSIMO comando (o, senza comandi, la prossima traccia) — tasto Spazio">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GO" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Spazio" FontSize="11" FontWeight="Normal" Opacity="0.85"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <DockPanel Grid.Column="1" Margin="10,0,18,0">
                    <Button DockPanel.Dock="Left" Style="{StaticResource BigBtn}" MinWidth="0" Width="84" Padding="0"
                            Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip="{Binding UndoLabel}"
                            Visibility="{Binding Features.Undo, Converter={StaticResource BoolVis}}" Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Annulla" FontSize="11" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="Ctrl+Z" FontSize="9.5" FontWeight="Normal" Opacity="0.7" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding NextLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubBrush}"/>
                        <TextBlock Text="{Binding NextTitle}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding NextSummary}" FontSize="12" Foreground="#BFD6FF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ChainText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}"
                                   Visibility="{Binding HasChain, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </DockPanel>

                <!-- SFUMA TUTTO as one split button: same height, the duration is in its menu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SplitLeft}" Height="60" MinWidth="150" Padding="18,0"
                            Background="{StaticResource OrangeBrush}" Foreground="White"
                            Command="{Binding FadeAllCommand}" ToolTip="Sfuma tutte le tracce in riproduzione (tasto F)">
                        <StackPanel>
                            <TextBlock Text="{Binding FadeAllLabel}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="F" FontSize="11" FontWeight="Normal" Opacity="0.8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SplitRight}" Height="60" Padding="12,0"
                            Background="{StaticResource OrangeBrush}" Foreground="White"
                            Click="FadeMenu_Click" Tag="master" ToolTip="Durata di «Sfuma tutto»">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                    </Button>
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource BigBtn}" Command="{Binding StopAllCommand}" Background="{StaticResource RedBrush}"
                        Foreground="White" Margin="10,0,0,0" ToolTip="Ferma subito tutto (tasto Esc)">
                    <StackPanel>
                        <TextBlock Text="STOP TUTTO" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Esc" FontSize="11" FontWeight="Normal" Opacity="0.8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- master EQ -->
                <Grid Grid.Column="4" Margin="10,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding Features.MasterEq, Converter={StaticResource BoolVis}}">
                    <ToggleButton x:Name="MasterEqBtn" Height="60" Width="76"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=MasterEqPop, Converter={StaticResource Not}}"
                                  ToolTip="Equalizzatore generale (su tutto l'audio in uscita)">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource TextToggle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MasterEqActive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <StackPanel>
                            <TextBlock Text="EQ" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="generale" FontSize="11" FontWeight="Normal" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="MasterEqPop" IsOpen="{Binding IsChecked, ElementName=MasterEqBtn}" StaysOpen="False"
                           PlacementTarget="{Binding ElementName=MasterEqBtn}" Placement="Top" AllowsTransparency="True">
                        <Border Style="{StaticResource PopupCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Azzera" Height="30" Padding="10,0"
                                            FontSize="12" Command="{Binding ResetMasterEqCommand}"/>
                                    <TextBlock Text="EQ generale" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding MasterEqBands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Border Grid.Column="5" Style="{StaticResource Card}" Margin="10,0,0,0" Padding="14,8" Width="250" VerticalAlignment="Center"
                        ToolTip="Volume generale (anche con la rotella del mouse)">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="VOLUME GENERALE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MasterVolume, StringFormat={}{0:0}%}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider Value="{Binding MasterVolume}" Margin="0,2,0,4" PreviewMouseWheel="Slider_PreviewMouseWheel"/>
                        <ProgressBar Height="4" Maximum="1" Value="{Binding MeterL, Mode=OneWay}" Background="#353B44" BorderThickness="0"
                                     Foreground="{StaticResource GreenBrush}" Margin="0,0,0,3"/>
                        <ProgressBar Height="4" Maximum="1" Value="{Binding MeterR, Mode=OneWay}" Background="#353B44" BorderThickness="0"
                                     Foreground="{StaticResource GreenBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- status -->
        <Border Grid.Row="4" Background="#121418" Padding="16,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding OutputText}" Foreground="{StaticResource SubBrush}" FontSize="12"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SaveText}" Foreground="{StaticResource TealBrush}" FontSize="12" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource SubBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
