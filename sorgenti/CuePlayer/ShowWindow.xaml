<Window x:Class="CuePlayer.ShowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CuePlayer.ViewModels"
        xmlns:local="clr-namespace:CuePlayer"
        Title="RTC Stage · Modalità spettacolo" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="#0E1013" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <local:InverseBoolConverter x:Key="Not"/>
        <local:AllTrueVisibilityConverter x:Key="AllTrueVis"/>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="28,22"/>
        </Style>
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
        </Style>

        <!-- a playing track: name, state, big countdown -->
        <DataTemplate x:Key="PlayingTrack" DataType="{x:Type vm:CueViewModel}">
            <Grid Margin="0,0,0,10" Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                <Border x:Name="Card" Background="#1F2329" CornerRadius="12" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Accent" CornerRadius="3" Background="{StaticResource GreenBrush}" Margin="0,-2,14,-2"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="State" Text="{Binding StateText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" Margin="0,2,0,6"/>
                            <ProgressBar x:Name="Bar" Height="6" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Background="#353B44"
                                         BorderThickness="0" Foreground="{StaticResource GreenBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="Remaining" Grid.Column="2" Text="{Binding RemainingText}" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="40" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    </Grid>
                </Border>
                <Border x:Name="Glow" CornerRadius="12" BorderBrush="{StaticResource RedBrush}" BorderThickness="3" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="paused">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource AmberBrush}"/>
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="fading">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource OrangeBrush}"/>
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="fadingin">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource BlueBrush}"/>
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource BlueBrush}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource BlueBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="ducking">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource AmberBrush}"/>
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="ducked">
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource TealBrush}"/>
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource TealBrush}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource TealBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnding}" Value="True">
                    <Setter TargetName="Remaining" Property="Foreground" Value="#FF7A80"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Blink">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Blink"/></DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Margin="0,0,0,18">
            <Image DockPanel.Dock="Left" Source="{StaticResource LogoImage}" Width="40" Height="40" Margin="0,0,14,0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="Exit_Click" Margin="16,0,0,0"
                    ToolTip="Torna alla vista normale (F11)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73F;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Esci  ·  F11"/>
                </StackPanel>
            </Button>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Clock}" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"
                       FontFamily="Cascadia Mono, Consolas"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding OutputText}" FontSize="13" Foreground="{StaticResource SubBrush}"
                       VerticalAlignment="Center" Margin="0,0,24,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RTC Stage" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="MODALITÀ SPETTACOLO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- NOW -->
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                        <TextBlock Text="ULTIMO COMANDO" Style="{StaticResource Kicker}"/>
                        <TextBlock FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding LastCommand.Name}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastCommand}" Value="{x:Null}">
                                            <Setter Property="Text" Value="— nessuno ancora —"/>
                                            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding LastCommand.Note}" FontSize="20" FontStyle="Italic" Foreground="#E9C77A"
                                   TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrueVis}">
                                    <Binding Path="LastCommand.HasNote"/>
                                    <Binding Path="Features.Notes"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="IN RIPRODUZIONE" Style="{StaticResource Kicker}" Margin="0,0,0,10"/>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cues}" ItemTemplate="{StaticResource PlayingTrack}"/>
                        </ScrollViewer>
                        <TextBlock Text="silenzio" FontSize="22" Foreground="#5C6470" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AnyActive}" Value="True">
                                            <Setter Property="Opacity" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- NEXT -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" BorderBrush="{StaticResource BlueBrush}" BorderThickness="2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROSSIMO  ·  Spazio" Style="{StaticResource Kicker}" Foreground="{StaticResource BlueBrush}"/>
                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                        <TextBlock Text="{Binding NextTitle}" FontSize="40" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NextCommand.Note}" FontSize="26" FontStyle="Italic" Foreground="#E9C77A"
                                   TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrueVis}">
                                    <Binding Path="NextCommand.HasNote"/>
                                    <Binding Path="Features.Notes"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <TextBlock Text="{Binding NextCommand.Summary}" FontSize="16" Foreground="{StaticResource SubBrush}"
                                   TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="24"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <TextBlock Text="POI" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding UpcomingCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CommandViewModel}">
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="{Binding ColorBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="#C9CED6"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- controls -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Btn}" Height="110" Width="90" Click="Prev_Click" ToolTip="Prossimo comando: uno indietro (↑)">
                <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="26"/>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource Btn}" Height="110" Margin="12,0" Background="{StaticResource GreenBrush}" Foreground="White"
                    Command="{Binding GoCommand}" ToolTip="Esegue il prossimo comando (Spazio)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="40" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="GO" FontSize="52" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource Btn}" Height="110" Width="90" Click="Next_Click" ToolTip="Prossimo comando: uno avanti (↓)">
                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="26"/>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource Btn}" Height="110" MinWidth="190" Margin="24,0,0,0"
                    Background="{StaticResource OrangeBrush}" Foreground="White" Command="{Binding FadeAllCommand}" ToolTip="Sfuma tutto (F)">
                <StackPanel>
                    <TextBlock Text="SFUMA TUTTO" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding MasterFadeSeconds, StringFormat=in {0:0.#} s  ·  F}" FontSize="13" FontWeight="Normal" Opacity="0.9" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource Btn}" Height="110" MinWidth="190" Margin="12,0,0,0"
                    Background="{StaticResource RedBrush}" Foreground="White" Command="{Binding StopAllCommand}" ToolTip="Ferma subito tutto (Esc)">
                <StackPanel>
                    <TextBlock Text="STOP TUTTO" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Esc" FontSize="13" FontWeight="Normal" Opacity="0.9" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
