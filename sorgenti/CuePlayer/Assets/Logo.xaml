                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- stage floor -->
                <GeometryDrawing Brush="#E9A93A" Geometry="M24,224 H232 V232 H24 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
