        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- tile -->
                <GeometryDrawing Geometry="M56,0 H200 A56,56 0 0 1 256,56 V200 A56,56 0 0 1 200,256 H56 A56,56 0 0 1 0,200 V56 A56,56 0 0 1 56,0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A2E37" Offset="0"/>
                            <GradientStop Color="#15171C" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- spotlight -->
                <GeometryDrawing Geometry="M128,58 L196,226 H60 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00F6D27A" Offset="0"/>
                            <GradientStop Color="#33F6D27A" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- left curtain -->
                <GeometryDrawing Geometry="M30,52 H94 C76,104 72,166 96,226 H30 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#8E1730" Offset="0"/>
